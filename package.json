{
  "name": "gestor-propiedades",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Gestor de propiedades interno (demo PWA, datos de ejemplo).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:live": "cross-env BASE_URL=https://rengifojjrr.github.io/gestor-propiedades/ playwright test tests/e2e/live.spec.ts",
    "check": "npm run lint && npm run typecheck && npm run test",
    "deploy": "gh-pages -d dist -t -m \"deploy: publica dist\""
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "dexie": "^4.4.7",
    "ical.js": "^2.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "luxon": "^3.7.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/leaflet": "^1.9.22",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.7",
    "gh-pages": "^6.3.0",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12",
    "workbox-window": "^7.4.1"
  }
}
