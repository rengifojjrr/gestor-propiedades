# Copia este archivo como .env.local (no se versiona).
# En local, `npm run db:start` lo escribe solo con los valores del stack local.

# Lo único que usa la app: la URL del proyecto de Supabase y su clave PUBLICABLE.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo para pruebas de integración, punta a punta y la semilla demo, y SOLO contra el stack local.
# La app nunca la lee. No la pongas en Vercel.
SUPABASE_SECRET_KEY=

# Semilla demo (opcional): con estos datos entra a un proyecto donde el usuario ya existe.
SEED_EMAIL=
SEED_PASSWORD=
