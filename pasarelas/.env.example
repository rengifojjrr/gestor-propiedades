# Así queda .env.local (no se versiona).
# En local no hace falta copiar este archivo: `npm run db:env` escribe en .env.local la URL y las claves del
# stack local en marcha, y conserva las demás variables que ya tenga (p. ej. las de la semilla).
# `npm run db:start` lo hace solo cuando .env.local falta o no trae la clave publicable.

# Lo único que usa la app: la URL del proyecto de Supabase y su clave PUBLICABLE.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo para pruebas de integración, punta a punta y la semilla demo, y SOLO contra el stack local.
# La app nunca la lee. No la pongas en Vercel.
SUPABASE_SECRET_KEY=

# Semilla demo (opcional): con estos datos entra a un proyecto donde el usuario ya existe.
SEED_EMAIL=
SEED_PASSWORD=

# Solo para desarrollo y pruebas (no es un secreto): la galería del kit de interfaz (/kit) existe con `next dev`;
# en producción da 404 salvo que se compile Y se arranque con PASARELAS_KIT=1 (`next build` deja el 404 fijo si
# no la ve). `npm run test:e2e` la enciende sola para e2e/kit.spec.ts. No la pongas en Vercel.
# PASARELAS_KIT=1
